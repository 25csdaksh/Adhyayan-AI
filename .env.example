# ==============================================================================
# StudyLM — Master Environment Configuration Template (.env.example)
# ==============================================================================

# Application & Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database Connection (MongoDB Atlas in Production)
MONGO_URI=mongodb://127.0.0.1:27017/studylm

# Authentication Security (JWT) - Must be >= 32 characters in production
JWT_SECRET=your_development_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_FILE_SIZE_MB=25

# Google Gemini AI & Embeddings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSIONS=768
ENABLE_PSEUDO_EMBEDDING_FALLBACK=false

# Payment Gateway & Subscriptions (Razorpay)
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PRO_PLAN_ID=plan_studylm_pro_monthly
RAZORPAY_ENTERPRISE_PLAN_ID=plan_studylm_enterprise_monthly
PRO_PLAN_PRICE_INR=999
ENTERPRISE_PLAN_PRICE_INR=4999

# Plan Quotas & Entitlements
LIMIT_FREE_NOTEBOOKS=15
LIMIT_FREE_SOURCES_PER_NOTEBOOK=30
LIMIT_FREE_MAX_FILE_SIZE_MB=25
LIMIT_FREE_MONTHLY_AI=300
LIMIT_FREE_MONTHLY_RESEARCH=30
LIMIT_FREE_MONTHLY_STUDY_TOOLS=60

LIMIT_PRO_NOTEBOOKS=100
LIMIT_PRO_SOURCES_PER_NOTEBOOK=200
LIMIT_PRO_MAX_FILE_SIZE_MB=100
LIMIT_PRO_MONTHLY_AI=3000
LIMIT_PRO_MONTHLY_RESEARCH=500
LIMIT_PRO_MONTHLY_STUDY_TOOLS=1000

# RAG & Semantic Search
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_DEFAULT_SCORE_THRESHOLD=0.1
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_CONTEXT_CHARS=30000
RAG_MAX_HISTORY_MESSAGES=8
MAX_CHAT_MESSAGE_LENGTH=5000

# Web Fetcher & SSRF Safeguards
WEB_FETCH_TIMEOUT_MS=15000
WEB_MAX_RESPONSE_BYTES=5000000
WEB_MAX_EXTRACTED_CHARS=2000000
WEB_MAX_REDIRECTS=5
WEB_SOURCE_CACHE_TTL_HOURS=24
WEB_SEARCH_PROVIDER=duckduckgo
