# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://localhost:27017/studylm

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Phase 05)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload Constraints
MAX_FILE_SIZE_MB=20

# Google Gemini Embedding Configuration (Phase 07)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
# Explicit development-only pseudo-embedding fallback (default: false, never enabled in production)
ENABLE_PSEUDO_EMBEDDING_FALLBACK=false

# Vector Search Parameters
DEFAULT_VECTOR_TOP_K=5
MAX_VECTOR_TOP_K=20
DEFAULT_VECTOR_SCORE_THRESHOLD=0.5
