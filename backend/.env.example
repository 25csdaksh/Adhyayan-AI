# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://localhost:27017/studylm

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Phase 05)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload Constraints
MAX_FILE_SIZE_MB=20

# Google Gemini AI & Embedding Configuration (Phase 07 & 08)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash
EMBEDDING_DIMENSIONS=768
# Explicit development-only pseudo-embedding fallback (default: false, never enabled in production)
ENABLE_PSEUDO_EMBEDDING_FALLBACK=false

# Vector Search Parameters (Phase 07)
DEFAULT_VECTOR_TOP_K=5
MAX_VECTOR_TOP_K=20
DEFAULT_VECTOR_SCORE_THRESHOLD=0.5

# RAG & Grounded Chat Parameters (Phase 08)
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_DEFAULT_SCORE_THRESHOLD=0.1
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_CONTEXT_CHARS=30000
RAG_MAX_HISTORY_MESSAGES=8
MAX_CHAT_MESSAGE_LENGTH=5000

# Web Fetcher & Ingestion (Phase 10)
WEB_FETCH_TIMEOUT_MS=15000
WEB_MAX_RESPONSE_BYTES=5000000
WEB_MAX_EXTRACTED_CHARS=2000000
WEB_MAX_REDIRECTS=5
WEB_SOURCE_CACHE_TTL_HOURS=24

# Web Search Provider (Phase 10)
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# Advanced Research & Multi-Source Synthesis (Phase 10)
RESEARCH_MAX_SEARCH_RESULTS=5
RESEARCH_MAX_FETCHED_SOURCES=5
RESEARCH_MAX_CONTEXT_CHUNKS=10
RESEARCH_MAX_CONTEXT_CHARS=40000
RESEARCH_MAX_HISTORY_MESSAGES=8
MAX_RESEARCH_QUERY_LENGTH=2000
