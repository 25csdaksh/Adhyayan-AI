# ==============================================================================
# StudyLM Backend — Production Environment Configuration (.env.production.example)
# ==============================================================================

# Application & Runtime
PORT=5000
NODE_ENV=production
CLIENT_URL=https://app.studylm.ai
FRONTEND_URL=https://app.studylm.ai
ALLOWED_ORIGINS=https://app.studylm.ai,https://studylm.ai

# MongoDB Atlas Production Cluster (TLS enabled)
MONGO_URI=mongodb+srv://studylm_app:<SECURE_PASSWORD>@cluster0.abcde.mongodb.net/studylm?retryWrites=true&w=majority&appName=StudyLMProd

# Authentication Security (JWT) - Cryptographically strong >= 32 characters
JWT_SECRET=production_strong_secret_key_minimum_32_characters_here_example
JWT_EXPIRES_IN=7d

# Cloudinary Production Media Assets
CLOUDINARY_CLOUD_NAME=studylm_prod
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_production_cloudinary_secret
MAX_FILE_SIZE_MB=25

# Google Gemini AI Production (Live API Key & text-embedding-004)
GEMINI_API_KEY=AIzaSyExampleProductionGeminiApiKeyHere12345
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSIONS=768
ENABLE_PSEUDO_EMBEDDING_FALLBACK=false

# Razorpay Live Subscription & Webhook Secrets
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=rzp_live_your_actual_live_key_id
RAZORPAY_KEY_SECRET=your_actual_live_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_live_webhook_secret
RAZORPAY_PRO_PLAN_ID=plan_studylm_pro_monthly
RAZORPAY_ENTERPRISE_PLAN_ID=plan_studylm_enterprise_monthly
PRO_PLAN_PRICE_INR=999
ENTERPRISE_PLAN_PRICE_INR=4999

# Plan Quotas & Entitlements
LIMIT_FREE_NOTEBOOKS=15
LIMIT_FREE_SOURCES_PER_NOTEBOOK=30
LIMIT_FREE_MAX_FILE_SIZE_MB=25
LIMIT_FREE_MONTHLY_AI=300
LIMIT_FREE_MONTHLY_RESEARCH=30
LIMIT_FREE_MONTHLY_STUDY_TOOLS=60

LIMIT_PRO_NOTEBOOKS=100
LIMIT_PRO_SOURCES_PER_NOTEBOOK=200
LIMIT_PRO_MAX_FILE_SIZE_MB=100
LIMIT_PRO_MONTHLY_AI=3000
LIMIT_PRO_MONTHLY_RESEARCH=500
LIMIT_PRO_MONTHLY_STUDY_TOOLS=1000

# RAG & Grounded Chat Parameters
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_DEFAULT_SCORE_THRESHOLD=0.1
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_CONTEXT_CHARS=30000
RAG_MAX_HISTORY_MESSAGES=8
MAX_CHAT_MESSAGE_LENGTH=5000

# Web Fetcher & Ingestion
WEB_FETCH_TIMEOUT_MS=15000
WEB_MAX_RESPONSE_BYTES=5000000
WEB_MAX_EXTRACTED_CHARS=2000000
WEB_MAX_REDIRECTS=5
WEB_SOURCE_CACHE_TTL_HOURS=24
WEB_SEARCH_PROVIDER=duckduckgo
